{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SurfaceDiff check report version 1",
  "type": "object",
  "required": ["report_version", "command", "status", "source", "baseline", "messages_checked", "changes", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "report_version": {"type": "integer", "const": 1},
    "command": {"const": "check"},
    "status": {"enum": ["passed", "different", "error"]},
    "source": {"type": "string"},
    "baseline": {"type": "string"},
    "messages_checked": {"type": "integer", "minimum": 0},
    "changes": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": ["code", "path", "before", "after"],
        "additionalProperties": false,
        "properties": {
          "code": {"enum": ["SURFACE_ADDED", "SURFACE_REMOVED", "COMPONENT_ADDED", "COMPONENT_REMOVED", "COMPONENT_TYPE_CHANGED", "PROPERTY_ADDED", "PROPERTY_REMOVED", "PROPERTY_CHANGED", "ACTION_CHANGED", "CHILD_ORDER_CHANGED", "REFERENCE_CHANGED", "DATA_ADDED", "DATA_REMOVED", "DATA_CHANGED"]},
          "path": {"type": "string"},
          "before": {"$ref": "#/$defs/side"},
          "after": {"$ref": "#/$defs/side"}
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "message", "line", "path", "file"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string"}, "message": {"type": "string"},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "path": {"type": "string"}, "file": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "side": {
      "oneOf": [
        {"type": "object", "required": ["state"], "additionalProperties": false, "properties": {"state": {"enum": ["absent", "undefined"]}}},
        {"type": "object", "required": ["state", "value", "undefined_paths"], "additionalProperties": false, "properties": {"state": {"const": "value"}, "value": {}, "undefined_paths": {"type": "array", "items": {"type": "string"}}}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"changes": {"maxItems": 0}, "diagnostics": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "different"}}}, "then": {"properties": {"changes": {"minItems": 1}, "diagnostics": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "error"}}}, "then": {"properties": {"changes": {"maxItems": 0}, "diagnostics": {"minItems": 1}}}}
  ]
}
